// brisbane.weir
// Models a simplified version of the real Brisbane River system, Queensland.
// Sourced from public descriptions of the catchment: the Upper Brisbane River
// is fed by Cooyar, Emu, and Cressbrook Creeks from the west, while the
// Stanley River flows south through Somerset Dam before joining the system
// at Wivenhoe Dam. Downstream, the Lockyer Creek and Bremer River join the
// Brisbane River in its middle and lower reaches before reaching Moreton Bay.
//
// Root rivers: cooyar, emu, cressbrook, stanleyriver, lockyercreek, bremerriver
// stanleyriver -> somersetdam -> upperstanley
// upperbrisbane = cooyar + emu + cressbrook + upperstanley
// upperbrisbane -> wivenhoedam -> midbrisbane
// lowerbrisbane = midbrisbane + lockyercreek + bremerriver (system output)

// 10-day rainfall schedule (in mm) across the Brisbane catchment
rainfall 12, 8, 0, 25, 10, 0, 0, 15, 5, 0;

root cooyar {
    catchment: 20;
    onset: 1;
    spread: 2;
}

root emu {
    catchment: 15;
    onset: 1;
    spread: 2;
}

root cressbrook {
    catchment: 18;
    onset: 1;
    spread: 2;
}

root stanleyriver {
    catchment: 35;
    onset: 1;
    spread: 3;
}

root lockyercreek {
    catchment: 12;
    onset: 2;
    spread: 2;
}

root bremerriver {
    catchment: 25;
    onset: 2;
    spread: 3;
}

// Somerset Dam adjusts outflow using accumulated level, today's rainfall, and inflow
dam somersetdam {
    when level > 150 or rainfall > 20: inflow * 0.4;
    when level > 80 and inflow > 100: inflow * 0.6;
    when level > 80: inflow * 0.75;
    default: inflow;
}

stanleyriver flows somersetdam;
somersetdam flows upperstanley;

river upperbrisbane = cooyar + emu + cressbrook + upperstanley;

// Wivenhoe Dam mitigates downstream flooding based on level and incoming flood surges
dam wivenhoedam {
    when level > 300 and rainfall > 10: inflow * 0.2;
    when level > 200 or inflow > 500: inflow * 0.5;
    when level > 100: inflow * 0.85;
    default: inflow;
}

upperbrisbane flows wivenhoedam;
wivenhoedam flows midbrisbane;

river lowerbrisbane = midbrisbane + lockyercreek + bremerriver;

print lowerbrisbane;